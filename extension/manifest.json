{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "0.2.0",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "126",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://grok.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content/ns.js",
        "content/platforms.js",
        "content/observer.js",
        "content/connection.js",
        "content/player.js",
        "content/viseme.js",
        "content/gestures.js",
        "content/meme.js",
        "content/town.js",
        "content/hud.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sprites/*",
        "assets/audio/*"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://grok.com/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "default_locale": "en"
}
