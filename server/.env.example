# --- Server ---
PORT=8787
# Comma-separated extra allowed WebSocket/CORS origins (chrome-extension://<id> is allowed when EXTENSION_ID is set).
ALLOWED_ORIGINS=https://claude.ai,https://grok.com,https://gemini.google.com
EXTENSION_ID=

# --- Storage (MVP: JSON file. Swap src/store.js for Postgres/Redis/etc. in production) ---
DATA_FILE=./data/store.json

# --- Metering ---
# Monthly character quota per plan (characters of transformed text sent to TTS).
QUOTA_FREE=20000
QUOTA_PRO=500000

# --- LLM style transfer ---
# "anthropic" or "mock" (mock echoes text with a persona prefix; no key needed).
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high. Low keeps latency down for live read-aloud.
LLM_EFFORT=low
# "keywords" (free, instant) or "llm" (falls back to the LLM when keywords don't decide).
INTENT_MODE=keywords

# --- TTS ---
# "fish" or "mock" (mock streams a bundled babble MP3 so the HUD animates without a key).
TTS_PROVIDER=mock
FISH_API_KEY=
FISH_WS_URL=wss://api.fish.audio/v1/tts/live
FISH_MODEL=s2.1-pro
FISH_LATENCY=balanced
# Used when a persona's fishAudioReferenceId is still a placeholder.
FISH_DEFAULT_VOICE_ID=
# Per-persona override: FISH_VOICE_<PERSONA_ID_UPPERCASE>=<voice uuid>
# FISH_VOICE_ELIAS_STILLWATER=
# FISH_VOICE_BIG_PLAY_RAY=
